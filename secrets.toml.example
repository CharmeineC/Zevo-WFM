# Copy this file to .streamlit/secrets.toml (local) or paste it into
# Streamlit Cloud → App settings → Secrets. Fill values from your service-account JSON key.
# Never commit the real file to GitHub.

sheet_url = "https://docs.google.com/spreadsheets/d/PASTE_YOUR_SHEET_ID/edit"
# Optional but recommended: code required to create the first admin login.
# Keep it ABOVE the [gcp_service_account] line.
setup_code = "choose-a-secret-code"

[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\nPASTE\nYOUR\nKEY\n-----END PRIVATE KEY-----\n"
client_email = "wfm-app@your-project-id.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
universe_domain = "googleapis.com"
